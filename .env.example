POSTGRES_DB=yihe_erp_dev
POSTGRES_USER=yihe_erp_dev
# Required. Set a unique random development password before starting Compose.
POSTGRES_PASSWORD=
# ERP_DEV_PORT=8080

# Set only in the authentication runtime; use independent random keys.
ERP_AUTH_ORIGIN=
ERP_AUTH_JWT_KEY=
ERP_AUTH_MFA_KEY=

# Optional local object store overlay. Fill with local-only credentials.
ERP_STORAGE_BUCKET=
ERP_STORAGE_ACCESS_KEY=
ERP_STORAGE_SECRET_KEY=
# ERP_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# ERP_CLAMD_HOST=
# ERP_PUBLIC_BRAND_COMPANY_ID=

# T011 test host only. Use immutable image digests in the protected test environment file.
# ERP_ENV=test
# ERP_POSTGRES_IMAGE=
# ERP_REDIS_IMAGE=
# ERP_API_IMAGE=
# ERP_WEB_IMAGE=
# ERP_WORKER_IMAGE=
# ERP_AUDIT_IDENTIFIER_KEY=
# ERP_TEST_STORAGE_ENV_FILE=
# ERP_MINIO_IMAGE=
# ERP_CLAMAV_IMAGE=
